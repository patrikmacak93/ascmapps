<?xml version="1.0" encoding="utf-8"?>
<!--
  Tenhle soubor leží v kořeni backendu, vedle server.js.
  Říká IIS: "všechny požadavky na tuhle aplikaci předej Node.js
  aplikaci server.js přes modul iisnode".

  V IIS se složka .../PackagingDatabase/api nastaví jako APLIKACE
  (Add Application). Statické stránky o úroveň výš (pckDtbSearch.html,
  pck-*.js, ...) dál servíruje běžný statický web - IIS je do node
  aplikace neposílá.
-->
<configuration>
  <system.webServer>

    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- 25 MB, ať projde i větší PSDS (musí sedět s PSDS_MAX_BYTES
             v nastaveni.js) -->
        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>

    <rewrite>
      <rules>
        <!-- Všechny požadavky předej do server.js - o routing se dál
             stará Express (api-routes.js). -->
        <rule name="AllToNode">
          <match url="/*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <iisnode nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;"
             watchedFiles="*.js;iisnode.yml"
             loggingEnabled="true"
             logDirectory="iisnode-log" />

  </system.webServer>
</configuration>
